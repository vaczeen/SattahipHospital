generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/gtw-client"
}

datasource db {
  provider = "mysql"
  url      = env("GTW_DATABASE_URL")
}

model users {
  id       Int    @id @default(autoincrement())
  username String @unique
  status   String
  
  @@map("users")
}